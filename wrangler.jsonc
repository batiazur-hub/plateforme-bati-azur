{
  // Portail Bati Azur : https://batiazurpiscine.fr
  //  - pages de connexion (mot de passe, mot de passe oublie par code mail) ;
  //  - le hub, sous /hub ;
  //  - la garde devant les outils internes (sous-domaines), qui recoivent les
  //    requetes par liaison de service une fois la session verifiee.
  "name": "hub-batiazur",
  "main": "src/portail.js",
  "compatibility_date": "2026-11-01",
  "workers_dev": false,
  "assets": { "directory": "./public", "binding": "ASSETS", "run_worker_first": true },
  "d1_databases": [
    { "binding": "DB", "database_name": "portail-batiazur", "database_id": "df64c1b1-6fad-4ad7-b39a-5b95dc6750e5" }
  ],
  "services": [
    { "binding": "SUIVI", "service": "suivi-clients" },
    { "binding": "PRO", "service": "batiazuranalysepro" },
    { "binding": "BONS", "service": "dashing-torrone" },
    // Implantation : l'outil est désormais Plongéo (édition Bati Azur, novembre 2026).
    // L'ancien outil ne sert plus que les relevés des coques Aboral (/geo/*.json).
    { "binding": "IMPLANTATION", "service": "plongeo" },
    { "binding": "IMPLANTATION_GEO", "service": "implatationpiscine" },
    // Analyse piscine (app publique des clients) : le portail ne fait que
    // relayer, sans connexion, et sert la nouvelle icone (novembre 2026).
    { "binding": "ANALYSE", "service": "batiazuranalyse" }
  ],
  "send_email": [
    { "name": "MAIL", "allowed_destination_addresses": ["bati.azur03@gmail.com"] }
  ],
  "triggers": { "crons": ["*/15 * * * *"] },
  "observability": { "enabled": true }
}
